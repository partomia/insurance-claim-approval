        EV[Evidence + OCR]
        FR[Fraud Detection]
        DE[Decision Engine]
        EX[Explainability]
    end

    subgraph Storage
        PG[(PostgreSQL)]
        RD[(Redis)]
        CH[(ChromaDB)]
        FS[File Storage]
    end

    subgraph External
        GQ[Groq LLM]
        OA[OpenAI Embeddings]
        TS[Tesseract OCR]
