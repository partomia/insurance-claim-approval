# Copy to .env (gitignored) for local runs: `set -a; source .env; set +a`
# On CAI the project environment variables hold these instead. Placeholders only.

# CDW Impala (CDP workload user, LDAP)
MCC_IMPALA_USER=
MCC_IMPALA_PASSWORD=

# Atlas / Ranger through the data lake Knox gateway (same workload user)
MCC_WORKLOAD_USER=
MCC_WORKLOAD_PASSWORD=
MCC_DL_CRN=

# Cloudera AI workbench, API v2
MCC_CAI_HOST=
MCC_CAI_API_KEY=
MCC_CAI_PROJECT_ID=

# Data Visualization API key (the instance signs users in with SAML)
MCC_VIZ_API_KEY=

# CDE virtual cluster (the CLI profile is ~/.cde/config.yaml)
MCC_CDE_VCLUSTER_ENDPOINT=

# Kafka (Streams Messaging Data Hub): SASL_SSL PLAIN with the workload user
MCC_KAFKA_BOOTSTRAP=
MCC_KAFKA_SECURITY_PROTOCOL=
MCC_KAFKA_SASL_MECHANISM=
MCC_KAFKA_USER=
MCC_KAFKA_PASSWORD=
MCC_KAFKA_CA_PEM=
MCC_SCHEMA_REGISTRY_URL=
MCC_SMM_API_URL=

# Copilot app LLM (also a CAI project variable)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# GitHub Actions secrets (repo Settings > Secrets and variables > Actions), not project variables:
# CAI_URL, CAI_API_KEY, CAI_PROJECT_ID

# Public benchmark (scripts/fetch_dataset.py): Kaggle API token (KGAT_...)
MCC_KAGGLE_API_TOKEN=
