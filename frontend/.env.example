# Backend API base URL — no trailing slash
# Local:              http://127.0.0.1:8000
# Cloudera subdomain: https://<backend-subdomain>.ml-....cloudera.site
# Cloudera /proxy:    https://YOUR-SESSION.ml-....cloudera.site/proxy/7878
#
# Vercel: Project Settings → Environment Variables → add VITE_API_URL, then redeploy
VITE_API_URL=http://127.0.0.1:8000
