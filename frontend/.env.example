# Backend base URL. Leave EMPTY for same-origin deploys — FastAPI serving
# frontend/dist on Cloudera AI, or the Vite dev proxy to 127.0.0.1:5550 (see
# vite.config.ts) in local dev via ./start.sh. Set this ONLY when the
# frontend is hosted on a different origin from the backend (e.g. Vercel
# calling a separately-hosted Cloudera AI / CML backend).
VITE_API_URL=
