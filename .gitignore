# OS
.DS_Store
Thumbs.db

# IDE / editor
.idea/
.vscode/
*.swp
*.swo

# Cursor / local tooling
.cursor/

# --- Backend (Python) ---
backend/.venv/
backend/venv/
backend/__pycache__/
backend/**/__pycache__/
backend/*.py[cod]
backend/*.egg-info/
backend/.pytest_cache/
backend/.coverage
backend/htmlcov/

# Backend secrets & local config
backend/.env
backend/.env.*
!backend/.env.example

# Backend database & runtime data
backend/*.db
backend/*.sqlite
backend/*.sqlite3
backend/*.db-journal
backend/*.db-wal
backend/*.db-shm
backend/test_*.db
backend/storage/
backend/chroma_db/
backend/faiss_index/

# Alembic generated revisions (keep folder via .gitkeep)
backend/alembic/versions/*
!backend/alembic/versions/.gitkeep

# --- Frontend (Node / Vite) ---
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.env
frontend/.env.*
!frontend/.env.example
frontend/*.local
frontend/logs/
frontend/*.log
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
frontend/pnpm-debug.log*

# --- Docs tooling ---
docs/diagrams/node_modules/

# Nested git repos (should not exist)
backend/.git/
frontend/.git/
backend/chroma_db.corrupt-*/
