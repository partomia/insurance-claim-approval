# Database
# Local dev (default — no Postgres required):
DATABASE_URL=sqlite:///./insurance.db
# Docker / production:
# DATABASE_URL=postgresql://postgres:postgres@postgres:5432/insurance_claims

# Redis / Celery
REDIS_URL=redis://redis:6379/0

# JWT
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# OpenAI (optional for local dev — FAISS uses random embeddings without key)
OPENAI_API_KEY=

# Groq LLM (powers claim decision reasoning, fraud analysis, coverage check)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Claim processing: auto | sync | celery
# Use sync on Cloudera CML if Redis/Celery is not running
CLAIM_PROCESSING_MODE=auto

# Paths
# Docker (docker-compose): UPLOAD_DIR=/app/storage
# Local / Cloudera CML: omit UPLOAD_DIR to use backend/storage (default)

# Decision thresholds
FRAUD_ESCALATE_THRESHOLD=0.75
HUMAN_REVIEW_AMOUNT_THRESHOLD=500000
CONFIDENCE_REVIEW_THRESHOLD=0.60

# Upload limits
MAX_UPLOAD_SIZE_MB=25

# --- Server / deployment (change per environment) ---

# Cloudera CML port proxy (enables /docs Swagger UI behind /proxy/<port>/)
# ROOT_PATH=/proxy/7878

# Allowed frontend origins (comma-separated, no trailing slashes)
# Local dev defaults are baked in; add your deployed frontend URL:
# CORS_ORIGINS=https://icp-frontend-new.ml-dbfc64d1-783.go01-dem.ylcu-atmi.cloudera.site,https://icn-agents.vercel.app,http://localhost:5173

# --- Assistant memory (STM per-thread + LTM per-persona) ---
# Tune to trade prompt cost vs. context depth. Defaults are sane for local dev.
# Recent turns kept verbatim on every LLM call.
# ASSISTANT_RECENT_TURN_LIMIT=8
# Compaction fires when BOTH thresholds are exceeded.
# ASSISTANT_COMPACTION_MESSAGE_THRESHOLD=16
# ASSISTANT_COMPACTION_CHAR_THRESHOLD=6000
# Cap on the running per-thread summary (chars).
# ASSISTANT_SUMMARY_CHAR_CAP=1500
# Max durable persona facts persisted per session.
# ASSISTANT_MAX_LONG_TERM_FACTS=20
# Rows returned by /chat history endpoints.
# ASSISTANT_HISTORY_LIMIT=30
# LLM budgets for the compaction / fact-extraction pass.
# ASSISTANT_SUMMARY_MAX_TOKENS=512
# ASSISTANT_LTM_EXTRACT_MAX_TOKENS=256
# One-time legacy chat backfill on startup. Set false in prod after first boot.
# ASSISTANT_BACKFILL_ON_STARTUP=true
