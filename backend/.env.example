# ─────────────────────────────────────────────────────────────
# Database backend — flip this ONE param to switch DBs
#   sqlite  → local file DB (default, works out of the box)
#   impala  → Cloudera CDP Data Warehouse (needs IMPALA_* below)
# ─────────────────────────────────────────────────────────────
DB_BACKEND=sqlite

# SQLite (used when DB_BACKEND=sqlite)
DATABASE_URL=sqlite:///./insurance.db

# Impala (used when DB_BACKEND=impala)
IMPALA_HOST=go01-aws-rtdm-gateway.go01-dem.ylcu-atmi.cloudera.site
IMPALA_PORT=443
IMPALA_DATABASE=default
IMPALA_USE_SSL=true
IMPALA_AUTH_MECHANISM=GSSAPI
IMPALA_USE_HTTP_TRANSPORT=true
IMPALA_HTTP_PATH=go01-aws-rtdm/cdp-proxy-api/impala
IMPALA_KERBEROS_SERVICE_NAME=impala

# Optional LDAP credentials (when GSSAPI/Kerberos is unavailable locally)
# IMPALA_AUTH_MECHANISM=LDAP
# IMPALA_USER=your-workload-username
# IMPALA_PASSWORD=your-password

# Optional — isolated schemas for crew parity tests (Impala only)
# IMPALA_PARITY_LEGACY_DB=ic_agents_legacy
# IMPALA_PARITY_CREW_DB=ic_agents_crew

# Redis / Celery
REDIS_URL=redis://redis:6379/0

# JWT
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# OpenAI (optional for local dev — Chroma uses random embeddings without key)
OPENAI_API_KEY=

# ─────────────────────────────────────────────────────────────
# LLM provider — pick ONE:
#   • Custom OpenAI-compatible endpoint (ENDPOINT + API_KEY) → used automatically
#     when both are set. Use this on CML where api.groq.com is blocked.
#   • Groq (GROQ_API_KEY) → used only when ENDPOINT/API_KEY are blank.
# ─────────────────────────────────────────────────────────────

# Custom OpenAI-compatible endpoint (e.g. Cloudera-hosted Hermes)
# ENDPOINT=https://<host>/namespaces/serving-default/endpoints/<model>/openai/v1
# API_KEY=
# LLM_MODEL must match the model id the endpoint serves.
# LLM_MODEL=hermes-3-llama-3-1-8b

# Groq LLM (default provider — powers assistant, claim reasoning, fraud/coverage)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Claim processing: auto | sync | celery
# Use sync on Cloudera CML if Redis/Celery is not running
CLAIM_PROCESSING_MODE=sync

# Paths
# Docker: UPLOAD_DIR=/app/storage
# Local / Cloudera CML: omit UPLOAD_DIR to use backend/storage (default)

# Decision thresholds
FRAUD_ESCALATE_THRESHOLD=0.75
HUMAN_REVIEW_AMOUNT_THRESHOLD=500000
CONFIDENCE_REVIEW_THRESHOLD=0.60

# Upload limits
MAX_UPLOAD_SIZE_MB=25

# Cloudera CML port proxy (enables /docs Swagger UI behind /proxy/<port>/)
# ROOT_PATH=/proxy/7878

# CORS_ORIGINS=https://your-frontend.example.com,http://localhost:5173

# Assistant memory tuning — see docs/env-reference.md
# ASSISTANT_BACKFILL_ON_STARTUP=true
